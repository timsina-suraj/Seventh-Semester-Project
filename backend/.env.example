# Copy to .env and adjust as needed. All values have safe local-dev defaults

# Async driver — this is what the running app uses. Alembic migrations use
# a derived sync equivalent automatically (see Settings.sync_database_url
# in app/config.py); there's no separate setting to keep in sync.
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./MediShield_db.db

# MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/medishield_db

# Generate with
# python -c "import secrets; print(secrets.token_urlsafe(64))
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Must decode to exactly 32 bytes (urlsafe-base64). Generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me

# --- OTP / Security (Module 3) ---
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15

LOG_LEVEL=INFO

# --- Appointments (Module 7) ---
APPOINTMENT_SLOT_MINUTES=30

# --- Documents (Module 12) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Email / SMTP (Mailpit — runs locally, no auth needed)
# Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false